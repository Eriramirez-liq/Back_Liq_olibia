# Conexión a la base de datos BIA-BI (PostgreSQL).
# Copiá este archivo a `.env` y completá con las credenciales reales.
# ⚠️  NUNCA commitees `.env` con credenciales — está en .gitignore.

# Opción A (recomendada): cadena de conexión completa.
#   postgres://USUARIO:PASSWORD@HOST:PUERTO/BASE
DATABASE_URL=postgres://usuario:password@localhost:5432/BIA-BI

# Opción B: variables sueltas (si no usás DATABASE_URL, psql las toma del entorno).
# PGHOST=localhost
# PGPORT=5432
# PGDATABASE=BIA-BI
# PGUSER=usuario
# PGPASSWORD=password
# PGSSLMODE=require        # p.ej. para conexiones gestionadas (Supabase/RDS)
