# PostgreSQL — Supabase
# DATABASE_URL / NEXT_DATABASE_URL: Direct connection (db.xxx.supabase.co:5432)
# FLASK_DATABASE_URL: Transaction pooler (pooler.supabase.com:6543)

DATABASE_URL="postgresql://postgres:TU_PASSWORD@db.TU_PROJECT_REF.supabase.co:5432/postgres"
NEXT_DATABASE_URL="postgresql://postgres:TU_PASSWORD@db.TU_PROJECT_REF.supabase.co:5432/postgres"
FLASK_DATABASE_URL="postgresql://postgres.TU_PROJECT_REF:TU_PASSWORD@aws-0-sa-east-1.pooler.supabase.com:6543/postgres"
FLASK_APP_URL="http://localhost:5001"

# Flask
SECRET_KEY=""   # Generar con: python -c "import secrets; print(secrets.token_hex(32))"
FLASK_DEBUG="true"
PORT="5001"

# ─── Integración NetSuite (Cargos STR) ───────────────────────────────────────
# Los VALORES reales se cargan en Vercel (Settings → Environment Variables),
# NUNCA en este repo ni en el chat. Solo nombres/placeholders acá.
# Cambiar a "real" activa el cliente con auth TBA/OAuth1; "mock" usa el simulado.
NETSUITE_MODE="mock"
# Cuenta 8312907 (producción) — defaults en código, overridables aquí:
# NETSUITE_BASE_URL="https://8312907.suitetalk.api.netsuite.com"  # host REST
# NETSUITE_ACCOUNT_ID="8312907"            # realm OAuth (= accountId en producción)
# NETSUITE_RECORD_PATH="/services/rest/record/v1/purchaseOrder"  # registro de la OC
# Purchase Order — IDs internos fijos de la cuenta (entity = vendor sale del OR).
# Defaults en código: subsidiary=2, item=488, quantity=1 (location NO se envía).
# NETSUITE_SUBSIDIARY_ID="2"               # internalId de la subsidiaria
# NETSUITE_LOCATION_ID=""                  # opcional: solo si la transacción lo requiere
# NETSUITE_ITEM_ID="488"                   # internalId del ítem de la línea
# NETSUITE_DEFAULT_QUANTITY="1"            # cantidad de la línea (número)
# NETSUITE_DEPARTMENT_ID="129"             # internalId del department
# NETSUITE_CATEGORIA_PROVEEDOR_ID="27"     # custbody_nso_categoria_proveedor_bia
# NETSUITE_CONSUMER_KEY=""                 # secret — solo en Vercel
# NETSUITE_CONSUMER_SECRET=""              # secret — solo en Vercel
# NETSUITE_TOKEN_ID=""                     # secret — solo en Vercel
# NETSUITE_TOKEN_SECRET=""                 # secret — solo en Vercel

# ─── Cron de Vercel (limpieza de lotes colgados) ─────────────────────────────
# Secreto que Vercel inyecta como `Authorization: Bearer <CRON_SECRET>` al
# invocar los crons. El endpoint /api/cargos-str/netsuite/cron/limpiar-lotes lo
# valida. Si no está set, el endpoint permite la ejecución pero logea un warning.
# Valor real SOLO en Vercel (Settings → Environment Variables).
CRON_SECRET=""

# ─── Conexión con olibia-web (front del módulo de Liquidaciones) ─────────────
# olibia-web consume este backend vía su proxy server-side
# /api/liquidations-proxy/[...path], que reenvía el Firebase ID token del
# usuario como `Authorization: Bearer <idToken>`. lib/auth-olibia.ts lo valida
# contra las llaves públicas de Google y lo mapea a un registro de `users`.
#
# Proyecto de Firebase con el que olibia firma los tokens (issuer + audience).
# Debe ser EXACTAMENTE el mismo NEXT_PUBLIC_FIREBASE_PROJECT_ID del front.
# Sin esta variable, todo request desde olibia-web responde 401.
# Dev: bia-eva-dev
FIREBASE_PROJECT_ID="bia-eva-dev"

# Dominios de correo aceptados desde olibia (coma-separados). Espeja la regla
# del login propio de este backend.
OLIBIA_ALLOWED_EMAIL_DOMAINS="@bia.app"

# Alta automática en `users` la primera vez que alguien de olibia entra.
# "false" exige darlos de alta antes desde Administración (si no, 401).
OLIBIA_AUTO_PROVISION_USERS="true"
# Rol con el que se crean esos usuarios: ANALISTA | ADMINISTRADOR | CONSULTA
OLIBIA_DEFAULT_ROL="ANALISTA"

# Puerto del dev server (`npm run dev` ya fija -p 4000). olibia-web apunta acá
# con NEXT_PUBLIC_LIQUIDATIONS_BACKEND_URL=http://localhost:4000; si se cambia
# uno, hay que cambiar el otro.

# ─── Bases de datos de BIA ───────────────────────────────────────────────────
# El módulo de liquidaciones está migrando de Supabase a las bases propias de
# BIA, fuente por fuente (ver lib/fuentes-migradas.ts). Estas son las conexiones
# que usa lib/db-bia.ts; requieren VPN o estar dentro de la red de BIA.
#
# Host del RDS. Dev: c4-rds-bia-dev.dev.bia.app
DB_HOST=""
DB_PORT="5432"

# Usuario de bia-bi (lectura de datos históricos).
DB_USER=""
DB_PASSWORD=""

# Usuario de file-compiler y calculator-prices. Es OTRO usuario: el de bia-bi
# no tiene permisos en esas bases. Si no se define, se cae a DB_USER/DB_PASSWORD.
DB_USER2=""
DB_PASSWORD2=""

# Nombres de base, por si cambian entre ambientes. Defaults en código:
# FILE_COMPILER_DB_NAME="file-compiler"
# CALCULATOR_PRICES_DB_NAME="calculator-prices"
# Tamaño del pool por base (default 5).
# BIA_DB_POOL_MAX="5"
